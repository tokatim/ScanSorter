<Window x:Class="ScanSorter.UI.TypesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Типы документов" Width="380" Height="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Название типа становится именем папки." Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
        <ListBox x:Name="TypesList" Grid.Row="1"/>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Добавить" Margin="6,0,0,0" Click="Add_Click"/>
            <TextBox x:Name="NewBox" Padding="4,3" KeyDown="NewBox_KeyDown"/>
        </DockPanel>
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Переименовать" Click="Rename_Click"/>
                <Button Content="Удалить" Click="Remove_Click"/>
                <Button Content="▲" Width="30" Click="Up_Click"/>
                <Button Content="▼" Width="30" Click="Down_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Готово" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Отмена" IsCancel="True" Margin="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

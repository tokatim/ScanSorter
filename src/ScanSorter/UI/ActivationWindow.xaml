<Window x:Class="ScanSorter.UI.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Активация программы" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Surface}">
    <StackPanel Margin="20">
        <TextBlock Text="Сортировщик сканов" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="ReasonText" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="{StaticResource Danger}"/>

        <TextBlock Text="1. Отправьте разработчику код этого компьютера" FontWeight="SemiBold"/>
        <DockPanel Margin="0,6,0,14">
            <Button DockPanel.Dock="Right" Content="Копировать" Margin="6,0,0,0" Click="CopyCode_Click"/>
            <TextBox x:Name="CodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="16" Padding="6,4" VerticalContentAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="2. Вставьте полученный ключ" FontWeight="SemiBold"/>
        <TextBox x:Name="KeyBox" Margin="0,6,0,6" Height="96" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Padding="6,4"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Вставить из буфера" Click="Paste_Click"/>
            <Button Content="Активировать" Style="{StaticResource PrimaryButton}" Padding="22,8" Click="Activate_Click"/>
            <Button Content="Выход" Margin="0" Padding="18,8" IsCancel="True" Click="Exit_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

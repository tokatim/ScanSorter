<Window x:Class="ScanSorter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScanSorter"
        Title="Сортировщик сканов" Width="1120" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Surface}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Куда складывать -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Папка вывода" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="OutputBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,3" Margin="0,0,6,0"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Обзор…" Click="BrowseOutput_Click"/>
                <Button Grid.Row="0" Grid.Column="3" Content="Открыть папку" Margin="0" Click="OpenOutput_Click"/>
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Тип" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DocTypeBox" Width="190" SelectionChanged="DocTypeBox_SelectionChanged"/>
                    <Button Content="Типы…" Margin="6,0,0,0" Click="EditTypes_Click"/>
                    <TextBlock Text="Год" VerticalAlignment="Center" Margin="28,0,10,0"
                               ToolTip="Для старых документов, где в номере нет года (вида «№ 1-154»): год берётся отсюда, и такие файлы обрабатываются без вопросов"/>
                    <TextBox x:Name="YearBox" Width="60" MaxLength="4" VerticalContentAlignment="Center" LostFocus="YearBox_LostFocus" KeyDown="YearBox_KeyDown"/>
                    <CheckBox x:Name="NoVolumeCheck" Content="Без тома (старые документы)" Margin="28,0,0,0" VerticalAlignment="Center" Click="NoVolumeCheck_Click"
                              ToolTip="Для старых документов вида «Зарегистрировано в реестре за N 23»: читается только номер, файл называется «год-номер», год берётся из поля «Год»"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Добавление файлов -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Text="Файлов: 0"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddFilesButton" Content="Добавить файлы…" Style="{StaticResource PrimaryButton}" Click="AddFiles_Click"/>
                <Button x:Name="AddFolderButton" Content="Добавить папку…" Click="AddFolder_Click"/>
                <CheckBox x:Name="SubfoldersCheck" Content="с вложенными папками" VerticalAlignment="Center" Margin="0,0,18,0" Click="SubfoldersCheck_Click"/>
                <Button x:Name="RemoveButton" Content="Убрать выбранные" Click="RemoveSelected_Click"/>
                <Button x:Name="ClearButton" Content="Очистить список" Click="Clear_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Список файлов -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource Border}" Background="White" RowHeight="30" IsReadOnly="False"
                      MouseDoubleClick="FilesGrid_DoubleClick">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть исходный файл" Click="OpenSource_Click"/>
                        <MenuItem Header="Открыть результат" Click="OpenResult_Click"/>
                        <MenuItem Header="Показать в папке" Click="ShowInFolder_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" IsReadOnly="True" Width="230"/>
                    <DataGridTextColumn Header="Папка" Binding="{Binding Folder}" IsReadOnly="True" Width="220"/>
                    <DataGridTextColumn Header="Стр." Binding="{Binding PageCountText}" IsReadOnly="True" Width="45"/>
                    <DataGridTemplateColumn Header="Тип" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static local:TypeList.Items}" SelectedItem="{Binding DocType, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Сохранён как" Binding="{Binding TargetText}" IsReadOnly="True" Width="220"/>
                    <DataGridTemplateColumn Header="Статус" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="16"
                       Foreground="{StaticResource TextMuted}" IsHitTestVisible="False"
                       Text="Перетащите сюда PDF-файлы или папки,&#x0a;либо нажмите «Добавить файлы…»"/>
        </Grid>

        <!-- Запуск -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="1" Value="0"/>
                <TextBlock x:Name="ProgressText" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" Text=""/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ReviewButton" Content="Проверка" IsEnabled="False" Click="Review_Click"/>
                <Button x:Name="StopButton" Content="Стоп" IsEnabled="False" Click="Stop_Click"/>
                <Button x:Name="StartButton" Content="Старт" Style="{StaticResource PrimaryButton}" Padding="30,8" Margin="0" Click="Start_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Text="Добавьте PDF-файлы и нажмите «Старт»."/>
    </Grid>
</Window>
